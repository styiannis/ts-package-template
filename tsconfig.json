{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "allowJs": true,
    "outDir": "build", // @note: Specifies where the TypeScript compiler (`tsc`) outputs its generated files. This directory is separate from the `dist` folder used by the `npm run build` script, which outputs the final build artifacts.
    "rootDir": "src"
  },
  "include": ["src"]
}
