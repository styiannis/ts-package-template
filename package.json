{
  "name": "ts-package-template",
  "version": "1.2.0",
  "description": "A TypeScript package template with per-module entry points and declared exports verified against the actual build output",
  "keywords": [
    "boilerplate",
    "commonjs",
    "dual-package",
    "esm",
    "package-template",
    "rollup",
    "subpath-exports",
    "template",
    "tree-shaking",
    "typescript"
  ],
  "author": "Yiannis Stergiou <hello@styiannis.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/styiannis/ts-package-template.git"
  },
  "bugs": {
    "url": "https://github.com/styiannis/ts-package-template/issues"
  },
  "type": "commonjs",
  "source": "src/index.ts",
  "main": "dist/cjs/index.cjs",
  "module": "dist/es/index.mjs",
  "types": "dist/@types/cjs/index.d.cts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.12.0",
    "npm": ">=8.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "node ./scripts/clear.cjs ./dist && rollup -c",
    "dev": "node ./scripts/clear.cjs ./dist && rollup -c --watch",
    "check-declared-paths": "node ./scripts/check-declared-paths.cjs",
    "check-dist-loads": "node ./scripts/check-dist-loads.cjs",
    "check-types": "tsc --noEmit",
    "check-updates": "npx npm-check-updates@23",
    "clear": "node ./scripts/clear.cjs ./build ./code_documentation ./coverage_report ./dist",
    "docs": "node ./scripts/clear.cjs ./code_documentation && typedoc --basePath ./ --entryPoints src/index.ts --entryPointStrategy Expand --readme none --includeVersion --out code_documentation",
    "format": "prettier -w ./",
    "lint": "oxlint --deny-warnings ./",
    "prepack": "npm i && npm run build",
    "reset": "npm run clear && node ./scripts/clear.cjs ./node_modules",
    "reset-hard": "npm run reset && node ./scripts/clear.cjs ./package-lock.json ./yarn.lock ./pnpm-lock.yaml",
    "test": "jest",
    "test-coverage": "node ./scripts/clear.cjs ./coverage_report && jest --coverage --coverageDirectory=coverage_report",
    "test-coverage-watch": "npm run test-coverage -- --watchAll",
    "test-watch": "jest --watchAll",
    "verify": "npm run check-types && npm run lint && npm run build && npm run check-declared-paths && npm run check-dist-loads"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/@types/es/index.d.mts",
        "default": "./dist/es/index.mjs"
      },
      "require": {
        "types": "./dist/@types/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./shapes": {
      "import": {
        "types": "./dist/@types/es/shapes/index.d.mts",
        "default": "./dist/es/shapes/index.mjs"
      },
      "require": {
        "types": "./dist/@types/cjs/shapes/index.d.cts",
        "default": "./dist/cjs/shapes/index.cjs"
      }
    },
    "./circle": {
      "import": {
        "types": "./dist/@types/es/shapes/circle.d.mts",
        "default": "./dist/es/shapes/circle.mjs"
      },
      "require": {
        "types": "./dist/@types/cjs/shapes/circle.d.cts",
        "default": "./dist/cjs/shapes/circle.cjs"
      }
    },
    "./square": {
      "import": {
        "types": "./dist/@types/es/shapes/square.d.mts",
        "default": "./dist/es/shapes/square.mjs"
      },
      "require": {
        "types": "./dist/@types/cjs/shapes/square.d.cts",
        "default": "./dist/cjs/shapes/square.cjs"
      }
    },
    "./triangle": {
      "import": {
        "types": "./dist/@types/es/shapes/triangle.d.mts",
        "default": "./dist/es/shapes/triangle.mjs"
      },
      "require": {
        "types": "./dist/@types/cjs/shapes/triangle.d.cts",
        "default": "./dist/cjs/shapes/triangle.cjs"
      }
    },
    "./degrees": {
      "import": {
        "types": "./dist/@types/es/angles/degrees.d.mts",
        "default": "./dist/es/angles/degrees.mjs"
      },
      "require": {
        "types": "./dist/@types/cjs/angles/degrees.d.cts",
        "default": "./dist/cjs/angles/degrees.cjs"
      }
    },
    "./radians": {
      "import": {
        "types": "./dist/@types/es/angles/radians.d.mts",
        "default": "./dist/es/angles/radians.mjs"
      },
      "require": {
        "types": "./dist/@types/cjs/angles/radians.d.cts",
        "default": "./dist/cjs/angles/radians.cjs"
      }
    },
    "./turns": {
      "import": {
        "types": "./dist/@types/es/angles/turns.d.mts",
        "default": "./dist/es/angles/turns.mjs"
      },
      "require": {
        "types": "./dist/@types/cjs/angles/turns.d.cts",
        "default": "./dist/cjs/angles/turns.cjs"
      }
    }
  }
}
